- MATCH,GLOBAL
rule-providers:
  ads_indonesia:
    type: file
    behavior: domain
    format: mrs
    path: ./rule_providers/compiled/ads_indonesia.mrs
  ads_domain:
    type: http
    behavior: domain
    path: ./rule_providers/ads_domain.mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/category-ads-all.mrs
    interval: 43200
    format: mrs
  anti-ad:
    type: http
    behavior: domain
    path: ./rule_providers/anti-ad-clash.yaml
    url: https://raw.githubusercontent.com/privacy-protection-tools/anti-AD/master/anti-ad-clash.yaml
    interval: 43200
    format: yaml
  tracker-domain:
