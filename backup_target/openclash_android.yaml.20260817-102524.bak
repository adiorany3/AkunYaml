proxy-groups:
- name: GLOBAL
  type: fallback
  proxies:
  - WARM-UP
  - WARM-UP-CF
  - AUTO-FAST
  - FALLBACK
  url: https://www.gstatic.com/generate_204
  interval: 30
  lazy: false
  timeout: 2500
  expected-status: 200/204/301/302
  max-failed-times: 2
