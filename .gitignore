# Local runtime state
.runtime_cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
.venv/
.local_bin/

# Local secrets must never enter Git.
.secrets/
.env
.env.*

# Feed cache is reproducible from feed_guard.py; keep tracked LKG files explicit.
.feed_cache/*.json
.feed_cache/*.tmp
config.yaml

# Generated profiles/providers are intentionally versioned for device updates.
# Keep validator runtime databases, temporary releases and backups local.
local_build/**/*.db
local_build/**/*.metadb
local_build/**/GeoSite.dat
local_build/**/GeoIP.dat
local_build/gameblock.previous/
local_build/gameblock-*/
local_build/independent-*/
output.previous/
output-stage-*/
